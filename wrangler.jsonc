{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "majid-savari-vakil",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "routes": [
    {
      "pattern": "majidsavarivakil.ir",
      "custom_domain": true
    },
    {
      "pattern": "www.majidsavarivakil.ir",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://majidsavarivakil.ir",
    "AUTH0_ROLE_CLAIM_NAMESPACE": "https://majidsavarivakil.ir",
    "AUTH0_DB_CONNECTION": "Username-Password-Authentication",
    "DATABASE_SSL": "true",
    "IMAGEKIT_PUBLIC_FOLDER": "/blog-images",
    "IMAGEKIT_PRIVATE_FOLDER": "/client-documents",
    "NEXTJS_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
