{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dadgar-site",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_vars": true,
	"secrets": {
		"required": [
			"SESSION_SECRET",
			"DATABASE_URL",
			"PASSWORD_RESET_WEBHOOK_URL",
			"PASSWORD_RESET_WEBHOOK_SECRET",
			"IMAGEKIT_PUBLIC_KEY",
			"IMAGEKIT_PRIVATE_KEY",
			"IMAGEKIT_URL_ENDPOINT",
		],
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "6b9db050bac14bd6b041bdbf04fff79a",
		},
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": false,
	},
	"routes": [
		{
			"pattern": "majidsavarivakil.ir",
			"custom_domain": true,
		},
		{
			"pattern": "www.majidsavarivakil.ir",
			"custom_domain": true,
		},
	],
	"vars": {
		"APP_BASE_URL": "https://majidsavarivakil.ir",
		"NEXT_PUBLIC_SITE_URL": "https://majidsavarivakil.ir",
		"DATABASE_SSL": "true",
		"IMAGEKIT_PUBLIC_FOLDER": "/blog-images",
		"IMAGEKIT_PRIVATE_FOLDER": "/client-documents",
		"NEXTJS_ENV": "production",
	},
	"observability": {
		"enabled": true,
	},
}
