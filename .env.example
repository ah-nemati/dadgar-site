# Local development
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Generate once with: openssl rand -base64 48
# Keep the same value across deployments; changing it invalidates every session.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Current PostgreSQL database. No second database is required.
DATABASE_URL="postgresql://dadgar:dadgar-local@localhost:5432/dadgar"
DATABASE_SSL="false"

# A Cloudflare-compatible HTTPS endpoint that sends the reset email.
# It receives an authenticated Bearer request containing: email, name, resetUrl and expiresInMinutes.
PASSWORD_RESET_WEBHOOK_URL="https://your-mail-worker.example.com/password-reset"
PASSWORD_RESET_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"

# ImageKit server-side storage
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_PUBLIC_FOLDER="/blog-images"
IMAGEKIT_PRIVATE_FOLDER="/client-documents"

# Used only by npm run db:seed. Do not expose these as NEXT_PUBLIC variables.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
INITIAL_ADMIN_NAME="مدیر سایت"
INITIAL_ADMIN_PHONE="09120000000"

INITIAL_LAWYER_EMAIL="savari.vakil2023@gmail.com"
INITIAL_LAWYER_PASSWORD="replace-with-a-strong-lawyer-password"
INITIAL_LAWYER_PHONE="09168038640"
