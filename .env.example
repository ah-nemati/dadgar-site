# Canonical production URL
NEXT_PUBLIC_SITE_URL="https://majidsavarivakil.ir"
APP_BASE_URL="https://majidsavarivakil.ir"

# Auth0 Regular Web Application
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_CLIENT_ID="your-regular-web-app-client-id"
AUTH0_CLIENT_SECRET="your-regular-web-app-client-secret"
# Generate with: openssl rand -hex 32
AUTH0_SECRET="64-hex-characters"

# Auth0 role claim and initial administrators
AUTH0_ROLE_CLAIM_NAMESPACE="https://majidsavarivakil.ir"
AUTH0_ADMIN_EMAILS="admin@example.com"

# Auth0 Machine-to-Machine application authorized for the Management API
# Required scopes: read:users create:users update:users delete:users
AUTH0_M2M_CLIENT_ID="your-m2m-client-id"
AUTH0_M2M_CLIENT_SECRET="your-m2m-client-secret"
AUTH0_DB_CONNECTION="Username-Password-Authentication"

# Neon PostgreSQL pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_SSL="true"

# ImageKit server-side storage
# Public Key is optional for the current server-side upload flow, but kept for future client uploads.
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
IMAGEKIT_PUBLIC_FOLDER="/blog-images"
IMAGEKIT_PRIVATE_FOLDER="/client-documents"
