{
  "name": "dadgar-law-firm-auth0",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "audit:storage": "node scripts/audit-storage.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run audit:storage && npm run audit:runtime && npm run build:next",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "cf:build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 NEXT_TELEMETRY_DISABLED=1 npx --yes @opennextjs/cloudflare@1.20.2 build",
    "preview": "npm run cf:build && wrangler dev --port 8787",
    "deploy": "npm run cf:build && wrangler deploy",
    "upload": "npx --yes @opennextjs/cloudflare@1.20.2 build && npx --yes @opennextjs/cloudflare@1.20.2 upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "clean": "rm -rf .next .open-next",
    "check": "npm run audit:storage && npm run audit:runtime && npm run typecheck && npm run lint && npm run build",
    "build:next": "node scripts/build-next.mjs",
    "install:clean": "rm -rf node_modules .next .open-next package-lock.json && npm install --include=optional",
    "deploy:ci": "npm run cf:build && wrangler deploy"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.26.0",
    "@imagekit/nodejs": "^7.10.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jalaali-js": "^2.0.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.30.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
