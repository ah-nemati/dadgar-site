{
  "name": "dadgar-law-firm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "audit:storage": "node scripts/audit-storage.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "cf:build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build",
    "cf:deploy": "node scripts/deploy-cloudflare.mjs",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && npm run cf:deploy",
    "upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "npm run audit:storage && npm run audit:runtime && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.10.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jalaali-js": "^2.0.0",
    "lucide-react": "^1.27.0",
    "next": "16.3.0",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
